# hubctl-atelier.service — service système du mini-serveur atelier de hubctl.
#
# GABARIT : les valeurs entre arobases (utilisateur, chemin du parc) sont des
# placeholders substitués à l'installation (install.sh ou `hubctl init`, fichier
# rendu dans packaging/.rendered/) — ne PAS copier ce fichier tel quel dans
# /etc/systemd/system : unit non démarrable (utilisateur/chemins absents).
#
# (`hubctl atelier --serve` : HTTP piloté par le Hub via GET /health,
#  GET /atelier/list, POST /atelier/close-all, GET /vault/status,
#  POST /vault/backup. Bind 172.17.0.1, cf. ExecStart :
#  joignable des conteneurs via host.docker.internal, invisible du LAN ;
#  l'auth X-Atelier-Token reste le vrai garde-fou d'exposition.)
#
# Installation et activation (token, rendu, systemctl) :
# voir hubctl_cli/README.md, section « Serveur hôte (atelier --serve) ».
#
# Le serveur n'écrit QUE dans le coffre, via POST /vault/backup (parc.vault.enc
# + .bak + artefact dump DB, répertoire hubctl_cli/vault) — d'où le
# ReadWritePaths minimal ci-dessous ; tout le reste du système reste en
# lecture seule (ProtectSystem=strict). Il lit le token
# (~/.config/hubctl/atelier_token), lit le code, et parle à Docker via le
# socket. Conséquence : le venv hubctl_cli/.venv doit exister AVANT
# l'activation (créé par n'importe quel lancement de ./hubctl — l'unit ne
# peut pas le construire).

[Unit]
Description=hubctl atelier — mini-serveur hôte de pilotage des ateliers (172.17.0.1)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Utilisateur du parc (owner du token ~/.config/hubctl/atelier_token) et
# chemin réel du parc : substitués à l'installation — voir en-tête.
User=@REAL_USER@
WorkingDirectory=@PARC_ROOT@
# --host 172.17.0.1 = passerelle docker0 : le conteneur hub-api joint le
# serveur via host.docker.internal (résout vers la passerelle) ; or 503
# systématique sur /atelier/close-all avec le bind 127.0.0.1 par défaut.
# 172.17.0.1 n'est pas routé depuis le LAN → pas d'exposition réseau ; le
# token X-Atelier-Token reste le vrai garde-fou.
ExecStart=@PARC_ROOT@/hubctl atelier --serve --host 172.17.0.1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5s

# ── Durcissement exigé ──
NoNewPrivileges=true
ProtectSystem=strict
# POST /vault/backup est la SEULE écriture du serveur (parc.vault.enc + .bak
# + artefact dump DB) : ouverture d'écriture restreinte au coffre.
ReadWritePaths=@PARC_ROOT@/hubctl_src/hubctl_cli/vault
PrivateTmp=true

# ── Durcissement complémentaire — validé en exécution réelle (serveur +
#    `docker ps` sous sandbox, journal propre) ; le service reste un serveur
#    TCP localhost : AF_UNIX/AF_INET/AF_INET6 autorisés, pas davantage.
ProtectHome=read-only
PrivateDevices=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
RemoveIPC=true
ProtectProc=invisible
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
