#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_DIR="$ROOT_DIR/hubctl_cli"
VENV="$PKG_DIR/.venv"
PY="$VENV/bin/python"
STAMP="$VENV/.deps-installed"
APT_HINT="  Sur Debian/Mint/Ubuntu, installe les prérequis : sudo apt install python3 python3-venv python3-pip"

# 1. python3 présent ?
if ! command -v python3 >/dev/null 2>&1; then
  echo "✗ python3 est requis mais introuvable." >&2
  echo "$APT_HINT" >&2
  exit 1
fi

# 2. (Re)créer le venv s'il est absent OU cassé (python présent mais pip inutilisable).
#    Cas typique : python3 installé sans python3-venv sur Debian/Mint → venv créé sans pip
#    (ensurepip absent), puis crash à l'appel de pip. On détecte et on reconstruit.
need_create=0
if [ ! -x "$PY" ]; then
  need_create=1
elif ! "$PY" -m pip --version >/dev/null 2>&1; then
  echo "→ venv existant mais pip inutilisable (python3-venv sans doute absent à la 1ʳᵉ création) — reconstruction…"
  rm -rf "$VENV"
  need_create=1
fi

if [ "$need_create" = "1" ]; then
  echo "→ Création de l'environnement Python (hubctl_cli/.venv)…"
  if ! python3 -m venv "$VENV"; then
    echo "✗ Échec de la création du venv (python3-venv probablement absent)." >&2
    echo "$APT_HINT" >&2
    exit 1
  fi
  # Vérifier que pip est bien disponible dans le venv créé.
  if ! "$PY" -m pip --version >/dev/null 2>&1; then
    echo "✗ Le venv a été créé sans pip (module ensurepip absent — paquet python3-venv manquant)." >&2
    echo "$APT_HINT" >&2
    echo "  Puis relance ./hubctl : le venv sera reconstruit automatiquement." >&2
    rm -rf "$VENV"
    exit 1
  fi
fi

# 3. Installer les dépendances si besoin (requirements modifié ou 1ʳᵉ fois).
if [ ! -f "$STAMP" ] || [ "$PKG_DIR/requirements.txt" -nt "$STAMP" ]; then
  echo "→ Installation des dépendances…"
  "$PY" -m pip install --quiet --upgrade pip >/dev/null
  "$PY" -m pip install --quiet -r "$PKG_DIR/requirements.txt"
  touch "$STAMP"
fi

cd "$ROOT_DIR"
exec "$PY" -m hubctl_cli "$@"
